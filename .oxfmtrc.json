{
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "bracketSpacing": true,
  "ignorePatterns": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    "**/*.d.ts",
    "**/generated/**",
    "packages/sdk-*/**",
    "**/wrangler.local.template.jsonc"
  ]
}
