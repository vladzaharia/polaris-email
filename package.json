{
  "name": "polaris-email",
  "version": "0.1.0",
  "private": true,
  "description": "Managed email service for the polaris-* family. Cloudflare Workers + Docker bridge.",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest --project unit run",
    "test:integration": "vitest --project in-workers --project out-workers --project api-workers run",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm fmt:check"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.0",
    "@types/node": "^22.0.0",
    "lefthook": "^2.1.6",
    "oxfmt": "^0.49.0",
    "oxlint": "^1.64.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.90.1"
  },
  "packageManager": "pnpm@9.0.0"
}
