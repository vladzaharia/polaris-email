# {{ .GeneratedBanner }}
#
# This is one of two equally-supported deployment modes for polaris-mail-bridge.
# See README.md for the other (docker-compose.local.yml for host-network mode).
#
# Tailnet-fronted mode:
#   - All listeners run inside the Tailscale sidecar's network namespace.
#   - MagicDNS hostname: polaris-mail-${REGION}.<tailnet>.ts.net
#   - TLS via Tailscale-issued certs (preferred) or Lego fallback.
#   - Only tailnet members reach the bridge — no public ports.
services:
  tailscale:
    image: tailscale/tailscale:stable
    container_name: polaris-mail-tailscale
    hostname: polaris-mail-${REGION:-{{ .Region }}}
    environment:
      TS_AUTHKEY: ${TS_AUTHKEY}
      TS_STATE_DIR: /var/lib/tailscale
      TS_USERSPACE: 'false'
      TS_EXTRA_ARGS: --advertise-tags=tag:polaris-mail
    volumes:
      - tailscale-state:/var/lib/tailscale
      - /dev/net/tun:/dev/net/tun
    cap_add: [NET_ADMIN, NET_RAW]
    healthcheck:
      test: ['CMD', 'tailscale', 'status', '--peers=0']
      interval: 30s
      timeout: 5s
      retries: 3
    restart: unless-stopped

  # Optional fallback cert manager. Tailscale-issued certs via tsnet are the
  # primary path; lego is only useful when running with TLS_MODE=lego in
  # bridge.toml.
  lego:
    image: goacme/lego:v4.14
    container_name: polaris-mail-lego
    network_mode: 'service:tailscale'
    environment:
      CF_DNS_API_TOKEN: ${CF_DNS_API_TOKEN:-}
    volumes:
      - lego-certs:/.lego
    command: >
      run --accept-tos --email ${ACME_EMAIL:-ops@example.com}
          --domains ${BRIDGE_FQDN:-polaris-mail-${REGION:-{{ .Region }}}.example.com}
          --dns cloudflare
          --path /.lego
    profiles: [lego]

  bridge:
    image: ghcr.io/vladzaharia/polaris-mail-bridge:{{ .ImageTag }}
    container_name: polaris-mail-bridge
    network_mode: 'service:tailscale'
    depends_on:
      tailscale:
        condition: service_healthy
    environment:
      # Listener / TLS knobs (BRIDGE_TLS_MODE: "tailscale" | "local";
      # tailscale mode requires a tsnet build — see internal/tls/tls.go).
      # Cert paths point at the lego output layout under
      # /etc/polaris-bridge/tls/certificates/<domain>.{crt,key} — Lego
      # writes there by default when --path is the parent directory. The
      # mount is read-only; rotation is handled by re-running the lego
      # profile (`docker compose --profile lego up`).
      BRIDGE_TLS_MODE: tailscale
      BRIDGE_TLS_CERT_PATH: /etc/polaris-bridge/tls/certificates/${BRIDGE_FQDN:-polaris-mail-${REGION:-{{ .Region }}}.example.com}.crt
      BRIDGE_TLS_KEY_PATH: /etc/polaris-bridge/tls/certificates/${BRIDGE_FQDN:-polaris-mail-${REGION:-{{ .Region }}}.example.com}.key
      # Bridge identity (consumed by config.Load; the *_FILE forms read from
      # docker-secret mounts so the secret never enters the env table).
      BRIDGE_NAME: polaris-mail-${REGION:-{{ .Region }}}
      BRIDGE_POLARIS_API_URL: ${POLARIS_API_URL:-{{ .PolarisAPIURL }}}
      BRIDGE_POLARIS_BRIDGE_ID_FILE: /run/secrets/bridge_id
      BRIDGE_POLARIS_HMAC_KEY_FILE: /run/secrets/hmac_key
      # Cloudflare Access service-token pair fronting the polaris control
      # plane. Required even on tailnet because the API itself sits behind
      # cf-access.
      BRIDGE_ACCESS_CLIENT_ID: ${ACCESS_CLIENT_ID:-}
      BRIDGE_ACCESS_CLIENT_SECRET: ${ACCESS_CLIENT_SECRET:-}
      # Public URL used by webhook bootstrap to compute target URLs.
      BRIDGE_PUBLIC_URL: ${BRIDGE_PUBLIC_URL:-{{ .PublicURL }}}
      # Listener toggles (default on; set to "false" to skip).
      BRIDGE_SMTPS_ENABLED: ${BRIDGE_SMTPS_ENABLED:-true}
      BRIDGE_IMAP_ENABLED: ${BRIDGE_IMAP_ENABLED:-true}
      BRIDGE_WEBHOOK_ENABLED: ${BRIDGE_WEBHOOK_ENABLED:-true}
      # On-disk paths.
      BRIDGE_CREDSTORE_PATH: /var/lib/polaris-bridge/credstore.db
      BRIDGE_MIRROR_PATH: /var/lib/polaris-bridge/mirror.db
      BRIDGE_LOGGING_FILE: /var/log/polaris-bridge/audit.jsonl
    volumes:
      - bridge-data:/var/lib/polaris-bridge
      - bridge-logs:/var/log/polaris-bridge
      # Lego writes to /.lego (its --path) → /.lego/certificates/<domain>.crt
      # We mount the same volume at /etc/polaris-bridge/tls so the loader's
      # BRIDGE_TLS_CERT_PATH (set above) resolves to
      # /etc/polaris-bridge/tls/certificates/<domain>.crt — the layout
      # Lego produces. Pre-Phase-4b.8 the mount target was
      # /etc/polaris-bridge/lego while the loader looked at
      # /etc/polaris-bridge/tls; the bridge silently failed cert load.
      - lego-certs:/etc/polaris-bridge/tls:ro
      - ./bridge.toml:/etc/polaris-bridge/bridge.toml:ro
      - ./secrets:/run/secrets:ro
    healthcheck:
      test: ['CMD', 'pgrep', '-f', 'polaris-bridge']
      interval: 30s
      timeout: 5s
      retries: 3
    restart: unless-stopped

volumes:
  tailscale-state:
  lego-certs:
  bridge-data:
  bridge-logs:
