# {{ .GeneratedBanner }}
#
# Operator-overrideable settings for the polaris-mail-bridge container.
# The wizard wrote sensible defaults; edit anything below to taste, then
# re-run `polaris-email setup bridge up` to apply.

# Bridge identity / control-plane.
BRIDGE_NAME={{ .BridgeName }}
POLARIS_API_URL={{ .PolarisAPIURL }}
BRIDGE_PUBLIC_URL={{ .PublicURL }}

# Port mapping (host-side; the container's ports are fixed).
BRIDGE_SMTPS_PORT={{ .SMTPSPort }}
BRIDGE_IMAP_PORT={{ .IMAPPort }}
BRIDGE_WEBHOOK_PORT={{ .WebhookPort }}

{{- if eq .Mode "tailscale" }}

# Tailscale sidecar — the wizard collected the auth-key from the operator
# and the secrets/ts_authkey file is wired through docker-compose. Override
# REGION if this bridge should advertise a different hostname:
#   polaris-mail-<REGION>.<tailnet>.ts.net
REGION={{ .Region }}
TS_AUTHKEY=${TS_AUTHKEY:-}
{{- end }}

{{- if or (eq .TLSSource "mounted") (eq .Mode "local") }}

# TLS source: mounted PEM at $BRIDGE_TLS_DIR (defaults to ./tls relative
# to docker-compose.yml). Rotate by replacing the files and `docker
# compose restart bridge`.
BRIDGE_TLS_DIR={{ .TLSDir }}
BRIDGE_FQDN={{ .FQDN }}
{{- end }}

{{- if eq .TLSSource "lego" }}

# Lego DNS-01 cert manager — credentials live in secrets/cf_dns_api_token
# (mode 0600) and the bridge volume-mounts the certificate output. Run
# `docker compose --profile lego up` to (re)issue.
BRIDGE_FQDN={{ .FQDN }}
ACME_EMAIL={{ .ACMEEmail }}
CF_DNS_API_TOKEN=${CF_DNS_API_TOKEN:-}
{{- end }}

# Access service-token pair — populated by the wizard from the registration
# response. DO NOT commit this file with these values intact.
ACCESS_CLIENT_ID={{ .AccessClientID }}
ACCESS_CLIENT_SECRET={{ .AccessClientSecret }}
