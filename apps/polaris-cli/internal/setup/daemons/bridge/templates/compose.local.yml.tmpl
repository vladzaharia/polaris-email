# {{ .GeneratedBanner }}
#
# This is one of two equally-supported deployment modes for polaris-mail-bridge.
# See README.md for the other (docker-compose.tailscale.yml for tailnet-fronted mode).
#
# Local / host-network mode:
#   - Bridge binds {{ .SMTPSPort }}/{{ .IMAPPort }} directly to the host network.
#   - Operator owns the firewall, reverse proxy (if any), and TLS termination
#     (operator-mounted PEM at /etc/polaris-bridge/tls/, or Lego ACME-DNS-01).
#   - Suitable when the host is already the public entry point or sits behind
#     a load balancer the operator controls.
services:
{{- if eq .TLSSource "lego" }}
  # Lego DNS-01 cert manager. Activated automatically because TLSSource=lego.
  lego:
    image: goacme/lego:v4.14
    container_name: polaris-mail-lego
    environment:
      CF_DNS_API_TOKEN: ${CF_DNS_API_TOKEN:-}
    volumes:
      - ${BRIDGE_TLS_DIR:-./tls}:/.lego
    command: >
      run --accept-tos --email ${ACME_EMAIL:-ops@example.com}
          --domains ${BRIDGE_FQDN:-{{ .FQDN }}}
          --dns cloudflare
          --path /.lego
    profiles: [lego]

{{- else }}
  # Optional cert manager. Skip if you're mounting operator-managed PEM files
  # directly. Activate with `docker compose --profile lego up`.
  lego:
    image: goacme/lego:v4.14
    container_name: polaris-mail-lego
    environment:
      CF_DNS_API_TOKEN: ${CF_DNS_API_TOKEN:-}
    volumes:
      - ${BRIDGE_TLS_DIR:-./tls}:/.lego
    command: >
      run --accept-tos --email ${ACME_EMAIL:-ops@example.com}
          --domains ${BRIDGE_FQDN:-{{ .FQDN }}}
          --dns cloudflare
          --path /.lego
    profiles: [lego]

{{- end }}

  bridge:
    image: ghcr.io/vladzaharia/polaris-mail-bridge:{{ .ImageTag }}
    container_name: polaris-mail-bridge
    # Bind the protocol ports directly on the host. Operator controls firewall.
    #
    # Port {{ .WebhookPort }} is the webhook receiver (BRIDGE_PUBLIC_URL must point at a
    # routable address polaris can hit). Plain HTTP by default — operators
    # that need TLS termination on the public webhook URL should put a
    # reverse proxy (caddy / nginx / cloudflared) in front of :{{ .WebhookPort }} and
    # set BRIDGE_PUBLIC_URL to the proxy's HTTPS URL.
    ports:
      - '${BRIDGE_SMTPS_PORT:-{{ .SMTPSPort }}}:465'
      - '${BRIDGE_IMAP_PORT:-{{ .IMAPPort }}}:993'
      - '${BRIDGE_WEBHOOK_PORT:-{{ .WebhookPort }}}:8080'
    environment:
      # Listener / TLS knobs. Local mode loads the PEM pair directly.
      BRIDGE_TLS_MODE: local
      BRIDGE_TLS_CERT_PATH: /etc/polaris-bridge/tls/fullchain.pem
      BRIDGE_TLS_KEY_PATH: /etc/polaris-bridge/tls/privkey.pem
      # Bridge identity (consumed by config.Load).
      BRIDGE_NAME: ${BRIDGE_NAME:-{{ .BridgeName }}}
      BRIDGE_POLARIS_API_URL: ${POLARIS_API_URL:-{{ .PolarisAPIURL }}}
      BRIDGE_POLARIS_BRIDGE_ID_FILE: /run/secrets/bridge_id
      BRIDGE_POLARIS_HMAC_KEY_FILE: /run/secrets/hmac_key
      # Cloudflare Access service-token pair fronting the polaris control
      # plane.
      BRIDGE_ACCESS_CLIENT_ID: ${ACCESS_CLIENT_ID:-}
      BRIDGE_ACCESS_CLIENT_SECRET: ${ACCESS_CLIENT_SECRET:-}
      # Public URL used by webhook bootstrap to compute target URLs (the
      # operator's reverse-proxy hostname or the host's public address).
      BRIDGE_PUBLIC_URL: ${BRIDGE_PUBLIC_URL:-{{ .PublicURL }}}
      # Listener toggles (default on).
      BRIDGE_SMTPS_ENABLED: ${BRIDGE_SMTPS_ENABLED:-true}
      BRIDGE_IMAP_ENABLED: ${BRIDGE_IMAP_ENABLED:-true}
      BRIDGE_WEBHOOK_ENABLED: ${BRIDGE_WEBHOOK_ENABLED:-true}
      # On-disk paths.
      BRIDGE_CREDSTORE_PATH: /var/lib/polaris-bridge/credstore.db
      BRIDGE_MIRROR_PATH: /var/lib/polaris-bridge/mirror.db
      BRIDGE_LOGGING_FILE: /var/log/polaris-bridge/audit.jsonl
    volumes:
      - bridge-data:/var/lib/polaris-bridge
      - bridge-logs:/var/log/polaris-bridge
      - ${BRIDGE_TLS_DIR:-./tls}:/etc/polaris-bridge/tls:ro
      - ./bridge.toml:/etc/polaris-bridge/bridge.toml:ro
      - ./secrets:/run/secrets:ro
    healthcheck:
      test: ['CMD', 'pgrep', '-f', 'polaris-bridge']
      interval: 30s
      timeout: 5s
      retries: 3
    restart: unless-stopped

volumes:
  bridge-data:
  bridge-logs:
