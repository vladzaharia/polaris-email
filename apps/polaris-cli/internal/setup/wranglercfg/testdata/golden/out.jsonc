// Template merged on top of services/out/wrangler.jsonc. Placeholders use
// Go text/template syntax and are substituted by the Go renderer in
// apps/polaris-cli/internal/setup/wranglercfg from .deploy-state.json +
// .env.deploy. Do NOT hand-edit the materialized wrangler.local.jsonc —
// re-run `polaris-email setup infra render` (or `make configure`).
//
// To add a new outbound sending domain:
//   1. `make dns DOMAIN=newdomain.example` and add the printed records
//   2. Add a `{ "name": "EMAIL_<TAG>", "destination_address": "outbound@newdomain.example" }` entry
//      to the `send_email` array below
//   3. `make deploy SERVICE=services/out`
{
  "account_id": "cf-account-id",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "polaris-email",
      "database_id": "d1-id",
    },
  ],
  "r2_buckets": [{ "binding": "R2", "bucket_name": "polaris-email", "jurisdiction": "eu" }],
  "send_email": [{ "name": "EMAIL_DEFAULT" }],
}
