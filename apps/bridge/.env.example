# polaris-email-bridge deployment environment. Copy to .env and fill in.
# Tailscale OAuth client secret + auth-key-creation params. The Tailscale container reads
# TS_AUTHKEY and exchanges OAuth secrets (tskey-client-...) for a fresh auth-key on boot.
# bin/bridge-up.sh writes this file automatically from TS_OAUTH_CLIENT_SECRET in .env.deploy;
# only fill this in by hand if you're bypassing the make targets.
TS_AUTHKEY=tskey-client-...?preauthorized=true&ephemeral=false
TS_TAILNET=example                      # your-tailnet (NOT the FQDN)
POLARIS_EMAIL_URL=https://polaris-email-api.workers.dev
POLARIS_BRIDGE_KEY_ID=pk_live_01...
POLARIS_BRIDGE_KEY_SECRET=...
SIDECAR_TAG=v0.1.0
