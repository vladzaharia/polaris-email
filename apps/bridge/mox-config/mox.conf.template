# polaris-email Mox static config template (mox.conf).
#
# Rendered by bin/bridge-up.sh from .env.deploy. The template uses ${...}
# placeholders that the renderer replaces with values from .env.deploy:
#
#   ${BRIDGE_HOST}   — public hostname (FQDN), e.g. mail.plrs.im
#
# Mox config docs (rendered from config/doc.go + struct sconf-doc tags):
#   https://www.xmox.nl/config/
#
# The dynamic file (domains.conf) is managed by Mox's admin RPCs at
# runtime; it is not rendered here. Account/address mutations performed by
# the sidecar's admin-API client (mox-client.ts) cause Mox to rewrite
# domains.conf in place and reload automatically.
#
# IMPORTANT: this is sconf, not YAML. Indentation is tabs in upstream
# examples but two spaces also parses; we use tabs to match Mox's own
# config/doc.go rendering and avoid surprises in `mox config test`.
#
# We intentionally do NOT include an ACME block: Mox's built-in ACME
# (autotls/autotls.go) only supports HTTP-01 and TLS-ALPN-01 (per the file
# header comment "We do tls-alpn-01, and also http-01. For DNS we would
# need a third party tool."). Since the bridge is Tailnet-only and not
# reachable from the public Internet on :80/:443, those challenge types
# fail. Certs are instead provisioned by the `cert-issuer` container
# (lego + Cloudflare DNS-01) and dropped into a shared volume at
# /certs/mail.<domain>.{crt,key}. Mox reads them via KeyCerts below.

DataDir: /home/mox
LogLevel: info
Hostname: ${BRIDGE_HOST}

# Admin password is bcrypt-hashed in this file (one bcrypt hash per line,
# only the first line is read). bin/bridge-up.sh renders it from
# MOX_ADMIN_PASSWORD in .env.deploy using `htpasswd -bnB` (so the same
# plaintext can be injected into the sidecar via env at startup).
AdminPasswordFile: adminpasswd

Postmaster:
	Account: postmaster
	Mailbox: Postmaster

# Default mailbox set for new accounts (matches Mox v0.0.15 defaults from
# store/account.go:83-91 — explicit here for clarity).
InitialMailboxes:
	SpecialUse:
		Sent: Sent
		Archive: Archive
		Trash: Trash
		Draft: Drafts
		Junk: Junk

Listeners:
	# Loopback listener for admin + webapi RPC. Reachable only from inside
	# the Tailscale netns (Mox shares network_mode: service:ts with the
	# sidecar in docker-compose.yml).
	internal:
		IPs:
			- 127.0.0.1
			- ::1
		AdminHTTP:
			Enabled: true
		WebAPIHTTP:
			Enabled: true
	# Public listener for SMTPS submission, IMAPS, and inbound SMTP. The
	# Tailscale netns provides the isolation; binding to 0.0.0.0 means
	# "all interfaces inside the netns", which in practice is just the
	# tailscale0 device plus loopback.
	public:
		IPs:
			- 0.0.0.0
			- "::"
		TLS:
			KeyCerts:
				-
					CertFile: /certs/${BRIDGE_HOST}.crt
					KeyFile: /certs/${BRIDGE_HOST}.key
		Submissions:
			Enabled: true
		IMAPS:
			Enabled: true
		SMTP:
			Enabled: true
