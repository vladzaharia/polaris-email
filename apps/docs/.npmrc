# Docusaurus uses @docusaurus/Loadable (a fork of react-loadable) which
# relies on webpack's `require.resolveWeak` runtime injection. pnpm's strict
# symlinked node_modules can cause webpack's bundle to reference modules
# via paths that bypass the runtime transform, throwing
# `require.resolveWeak is not a function` during the SSR step.
#
# `node-linker=hoisted` flattens this workspace's node_modules into a
# classic npm-style layout. It only affects apps/docs; the rest of the
# monorepo still uses pnpm's default isolated layout.
node-linker=hoisted
