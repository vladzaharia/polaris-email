{
  "name": "@polaris-email/docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "docs:start": "docusaurus start",
    "docs:gen-api": "docusaurus gen-api-docs all",
    "docs:clean-api": "docusaurus clean-api-docs all",
    "docs:build": "docusaurus build",
    "build:client": "pnpm run docs:gen-api && pnpm run docs:build",
    "postbuild:client": "pagefind --site build --output-subdir pagefind",
    "build:server": "tsc -p tsconfig.server.json --noEmit",
    "build": "pnpm run build:client && pnpm run build:server",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.json --noEmit",
    "lint": "oxlint .",
    "dev:server": "wrangler dev",
    "deploy": "polaris-email setup infra deploy service docs"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.1",
    "@docusaurus/preset-classic": "^3.10.1",
    "@docusaurus/theme-common": "^3.10.1",
    "clsx": "^2.1.1",
    "docusaurus-plugin-openapi-docs": "^5.0.2",
    "docusaurus-plugin-sass": "^0.2.6",
    "docusaurus-theme-openapi-docs": "^5.0.2",
    "hono": "^4.12.19",
    "prism-react-renderer": "^2.4.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sass": "^1.99.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260517.1",
    "@docusaurus/module-type-aliases": "^3.10.1",
    "@docusaurus/tsconfig": "^3.10.1",
    "@docusaurus/types": "^3.10.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "oxlint": "^1.65.0",
    "pagefind": "^1.5.2",
    "typescript": "^5.5.0",
    "wrangler": "^4.92.0"
  },
  "//": "Note: docusaurus build is broken with webpack >=5.106 (facebook/docusaurus#11923). The pnpm override pinning `webpack` to 5.105.0 lives in the root package.json so it applies to the whole tree."
}
