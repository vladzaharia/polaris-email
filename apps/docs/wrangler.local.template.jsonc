// Template merged on top of apps/docs/wrangler.jsonc during deploy.
// Placeholders are substituted from .deploy-state.json + .env.deploy.
// Do NOT hand-edit the materialized wrangler.local.jsonc — re-run
// `polaris-mail setup infra render` instead.
{
  "account_id": "{{ .Env.CF_ACCOUNT_ID }}",
  // docs.mail.plrs.im is the canonical hostname for the docs site. The
  // zone is the same `mail.plrs.im` zone that fronts r2.mail.plrs.im.
  "routes": [
    {
      "pattern": "{{ .Env.POLARIS_DOCS_HOSTNAME }}/*",
      "zone_name": "{{ .Env.POLARIS_DOCS_ZONE }}",
    },
  ],
}
