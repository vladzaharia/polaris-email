{
  "responses": {
    "200": {
      "description": "list",
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "required": ["data"],
            "properties": {
              "data": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "name", "created_at", "updated_at"],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                      "title": "Ulid"
                    },
                    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
                    "description": { "type": "string", "nullable": true },
                    "default_sender_id": {
                      "allOf": [
                        { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$", "title": "Ulid" }
                      ],
                      "nullable": true
                    },
                    "created_at": { "type": "string" },
                    "updated_at": { "type": "string" },
                    "disabled_at": { "type": "string", "nullable": true }
                  },
                  "title": "Mailbox"
                }
              }
            }
          }
        }
      }
    }
  }
}
