{
  "schema": {
    "type": "object",
    "required": ["api_key_id", "api_key_prefix", "api_key_secret", "login_token"],
    "properties": {
      "operator": {
        "type": "object",
        "required": [
          "id",
          "name",
          "email",
          "ssh_pubkey_fp_sha256",
          "api_key_id",
          "role",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$", "title": "Ulid" },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "email": { "type": "string", "format": "email" },
          "ssh_pubkey": {
            "type": "string",
            "description": "Full authorized_keys line. Omitted from list responses."
          },
          "ssh_pubkey_fp_sha256": {
            "type": "string",
            "pattern": "^SHA256:[A-Za-z0-9+/]{43}$",
            "description": "SHA256 fingerprint matching `ssh-keygen -E sha256 -lf`."
          },
          "api_key_id": {
            "type": "string",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "title": "Ulid"
          },
          "role": { "type": "string", "enum": ["admin", "operator", "readonly"] },
          "disabled_at": { "type": "string", "format": "date-time", "nullable": true },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" },
          "last_seen_at": { "type": "string", "format": "date-time", "nullable": true }
        },
        "title": "Operator"
      },
      "api_key_id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$", "title": "Ulid" },
      "api_key_prefix": { "type": "string" },
      "api_key_secret": {
        "type": "string",
        "description": "Returned ONCE — store via polaris-email login."
      },
      "login_token": {
        "type": "string",
        "pattern": "^polaris_[0-9A-HJKMNP-TV-Z]{26}\\..+$",
        "description": "Convenience bundle (polaris_{key_id}.{secret}) for `polaris-email login`."
      }
    },
    "title": "OperatorIssueResponse"
  },
  "schemaType": "response"
}
