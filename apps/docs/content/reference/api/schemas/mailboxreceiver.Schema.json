{
  "schema": {
    "type": "object",
    "required": [
      "id",
      "mailbox_id",
      "domain_id",
      "priority",
      "address_pattern",
      "action",
      "enabled",
      "created_at"
    ],
    "properties": {
      "id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$", "title": "Ulid" },
      "mailbox_id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$", "title": "Ulid" },
      "domain_id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$", "title": "Ulid" },
      "priority": { "type": "integer" },
      "address_pattern": { "type": "string", "minLength": 1, "maxLength": 512 },
      "action": { "type": "string", "enum": ["webhook", "forward", "drop"] },
      "webhook_sub_id": {
        "allOf": [{ "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$", "title": "Ulid" }],
        "nullable": true
      },
      "forward_to": { "type": "string", "nullable": true },
      "enabled": { "type": "integer", "minimum": 0, "maximum": 1 },
      "created_at": { "type": "string" },
      "disabled_at": { "type": "string", "nullable": true }
    },
    "title": "MailboxReceiver"
  },
  "schemaType": "response"
}
