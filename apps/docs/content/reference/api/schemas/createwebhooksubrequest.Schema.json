{
  "schema": {
    "type": "object",
    "required": ["mailbox_id", "url", "kind", "events"],
    "properties": {
      "mailbox_id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$", "title": "Ulid" },
      "url": { "type": "string", "format": "uri" },
      "kind": { "type": "string", "enum": ["external", "tailnet"] },
      "events": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "enum": [
            "message.received",
            "message.sent",
            "message.delivered",
            "message.bounced",
            "message.failed"
          ],
          "title": "WebhookEventType"
        }
      }
    },
    "title": "CreateWebhookSubRequest"
  },
  "schemaType": "response"
}
