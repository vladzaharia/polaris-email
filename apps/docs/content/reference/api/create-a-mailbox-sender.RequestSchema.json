{
  "title": "Body",
  "body": {
    "required": true,
    "content": {
      "application/json": {
        "schema": {
          "type": "object",
          "required": ["local_part"],
          "properties": {
            "domain_id": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
              "title": "Ulid"
            },
            "local_part": { "type": "string", "pattern": "^[a-z0-9._+-]{1,64}$" },
            "display_name": { "type": "string", "minLength": 1, "maxLength": 120 },
            "default_for_mailbox": { "type": "boolean" }
          },
          "title": "CreateMailboxSenderRequest"
        }
      }
    }
  }
}
