                "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                "title": "Ulid"
              },
              "domain_id": {
                "type": "string",
                "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                "title": "Ulid"
              },
              "address": { "type": "string" },
              "local_part": { "type": "string", "nullable": true },
