              "mailbox_id",
              "domain_id",
              "address",
              "default_for_mailbox",
              "created_at"
            ],
            "properties": {
              "id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$", "title": "Ulid" },
