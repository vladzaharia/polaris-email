{
  "title": "Body",
  "body": {
    "required": true,
    "content": {
      "application/json": {
        "schema": {
          "type": "object",
          "required": ["mailbox_id"],
          "properties": {
            "mailbox_id": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
              "title": "Ulid"
            },
            "display_name": { "type": "string", "minLength": 1, "maxLength": 120 },
            "sender_ids": {
              "type": "array",
              "items": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$", "title": "Ulid" }
            },
            "scopes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "enum": [
                  "send",
                  "messages:read",
                  "imap_bridge:read",
                  "admin:rotate",
                  "admin:read",
                  "admin:impersonate"
                ],
                "title": "KeyScope"
              }
            },
            "rate_limit_per_min": { "type": "integer", "default": 1000 }
          },
          "title": "IssueApiKeyRequest"
        }
      }
    }
  }
}
