{
  "title": "Body",
  "body": {
    "required": true,
    "content": {
      "application/json": {
        "schema": {
          "type": "object",
          "required": ["event_id", "event", "occurred_at", "message"],
          "description": "v2 webhook envelope delivered to subscribers. The HTTP request carries\n`X-Polaris-Sig: <hex>`, `X-Polaris-Ts`, `X-Polaris-Nonce`,\n`X-Polaris-Event-Id`, and `X-Polaris-Event` headers. Verify with the SDK\n`verifyWebhook` helper.\n",
          "properties": {
            "event_id": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
              "title": "Ulid"
            },
            "event": {
              "type": "string",
              "enum": [
                "message.received",
                "message.sent",
                "message.delivered",
                "message.bounced",
                "message.failed"
              ],
              "title": "WebhookEventType"
            },
            "occurred_at": { "type": "string" },
            "message": {
              "type": "object",
              "required": [
                "id",
                "mailbox_id",
                "direction",
                "status",
                "from",
                "to",
                "attachments",
                "created_at"
              ],
              "properties": {
                "id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$", "title": "Ulid" },
                "mailbox_id": {
                  "type": "string",
                  "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                  "title": "Ulid"
                },
                "direction": { "type": "string", "enum": ["in", "out"] },
                "status": {
                  "type": "string",
                  "enum": [
                    "received",
                    "mime_stored",
                    "queued",
                    "sending",
                    "sent",
                    "bounced",
                    "delivered",
                    "failed"
                  ]
                },
                "from": { "type": "string" },
                "from_addr": { "type": "string", "format": "email" },
                "to": { "type": "array", "items": { "type": "string" } },
                "cc": { "type": "array", "items": { "type": "string" } },
                "bcc": { "type": "array", "items": { "type": "string" } },
                "subject": { "type": "string" },
                "text": { "type": "string" },
                "html": { "type": "string" },
                "body_url": {
                  "type": "string",
                  "format": "uri",
                  "description": "Public, content-addressed URL for the raw RFC822 body on the R2\ncustom domain `r2.mail.plrs.im`. Absolute, no expiry. SHA-256\nin the path provides unguessability — treat the URL as a\ncapability token. Fetch directly without HMAC.\n"
                },
                "headers": { "type": "object", "additionalProperties": { "type": "string" } },
                "attachments": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["filename", "content_type", "size_bytes"],
                    "properties": {
                      "filename": { "type": "string" },
                      "content_type": { "type": "string" },
                      "size_bytes": { "type": "integer", "minimum": 0 },
                      "content_base64": { "type": "string" },
                      "url": {
                        "type": "string",
                        "format": "uri",
                        "description": "Public, content-addressed URL on the R2 custom domain\n`r2.mail.plrs.im`. Absolute, no expiry. SHA-256 in the\npath provides unguessability — treat the URL as a capability\ntoken. Fetch directly without HMAC.\n"
                      }
                    },
                    "title": "MessageAttachment"
                  }
                },
                "header_message_id": { "type": "string" },
                "thread_id": { "type": "string" },
                "auth": {
                  "type": "object",
                  "properties": {
                    "spf": { "type": "string" },
                    "dkim": { "type": "string" },
                    "dmarc": { "type": "string" },
                    "remote_ip": { "type": "string" }
                  },
                  "title": "MessageAuth"
                },
                "body_bytes": { "type": "integer", "minimum": 0 },
                "attachments_total_bytes": { "type": "integer", "minimum": 0 },
                "received_at_bridge": { "type": "string" },
                "received_at_api": { "type": "string" },
                "queued_at": { "type": "string" },
                "sending_at": { "type": "string" },
                "sent_at": { "type": "string" },
                "delivered_at": { "type": "string" },
                "failed_at": { "type": "string" },
                "bounce_metadata": {},
                "last_error": { "type": "string" },
                "created_at": { "type": "string" },
                "flags": {
                  "type": "array",
                  "description": "IMAP flags for this message in the resolving mailbox. System flags\n(`\\Seen`, `\\Answered`, `\\Flagged`, `\\Deleted`) per RFC 9051 §2.3.2,\nplus any custom keywords the client has stored. Polaris does not\nship `\\Draft` (INBOX-only model — no folder dimension).\n",
                  "items": { "type": "string" }
                },
                "read_at": {
                  "type": "string",
                  "nullable": true,
                  "description": "ISO-8601 timestamp at which `\\Seen` was first set in the resolving\nmailbox. `null` until the message is marked read.\n"
                },
                "change_id": {
                  "type": "integer",
                  "format": "int64",
                  "minimum": 0,
                  "description": "Monotonic per-mailbox change cursor (IMAP CONDSTORE MODSEQ). Bumped\non every state mutation; `GET /v1/mailboxes/:id/changes?since_state=`\nuses it for delta queries.\n"
                }
              },
              "title": "Message"
            }
          },
          "title": "WebhookEnvelope"
        }
      }
    }
  }
}
