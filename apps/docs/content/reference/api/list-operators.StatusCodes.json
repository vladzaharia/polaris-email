{
  "responses": {
    "200": {
      "description": "ok",
      "content": {
        "application/json": {
          "schema": {
            "type": "object",
            "properties": {
              "data": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "name",
                    "email",
                    "ssh_pubkey_fp_sha256",
                    "api_key_id",
                    "role",
                    "created_at",
                    "updated_at"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                      "title": "Ulid"
                    },
                    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
                    "email": { "type": "string", "format": "email" },
                    "ssh_pubkey": {
                      "type": "string",
                      "description": "Full authorized_keys line. Omitted from list responses."
                    },
                    "ssh_pubkey_fp_sha256": {
                      "type": "string",
                      "pattern": "^SHA256:[A-Za-z0-9+/]{43}$",
                      "description": "SHA256 fingerprint matching `ssh-keygen -E sha256 -lf`."
                    },
                    "api_key_id": {
                      "type": "string",
                      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                      "title": "Ulid"
                    },
                    "role": { "type": "string", "enum": ["admin", "operator", "readonly"] },
                    "disabled_at": { "type": "string", "format": "date-time", "nullable": true },
                    "created_at": { "type": "string", "format": "date-time" },
                    "updated_at": { "type": "string", "format": "date-time" },
                    "last_seen_at": { "type": "string", "format": "date-time", "nullable": true }
                  },
                  "title": "Operator"
                }
              }
            }
          }
        }
      }
    }
  }
}
