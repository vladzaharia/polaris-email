{
  "title": "Body",
  "body": {
    "required": true,
    "content": {
      "application/json": {
        "schema": {
          "type": "object",
          "required": ["domain_id", "address_pattern"],
          "properties": {
            "domain_id": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
              "title": "Ulid"
            },
            "priority": { "type": "integer", "default": 100 },
            "address_pattern": { "type": "string", "minLength": 1, "maxLength": 512 },
            "action": {
              "type": "string",
              "enum": ["webhook", "forward", "drop"],
              "default": "webhook"
            },
            "webhook_sub_id": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
              "title": "Ulid"
            },
            "forward_to": { "type": "string" }
          },
          "title": "CreateMailboxReceiverRequest"
        }
      }
    }
  }
}
