// polaris-email-cli-installer Worker — committed config. Real account ID
// lives in wrangler.local.jsonc (gitignored) and is merged in before
// `wrangler deploy`.
//
// This Worker hosts the POSIX-sh installer at https://cli.mail.plrs.im.
// `src/install.sh` is the source of truth; the `build.command` hook below
// base64-encodes it into `src/install.sh.gen.ts` before bundling, which is
// then imported and decoded by the Worker at module load. The indirection
// exists because Cloudflare's WAF on api.cloudflare.com blocks Worker
// uploads whose multipart payload contains shell-injection signatures —
// bundling raw install.sh content fails with HTTP 403 + a CF block page.
// See scripts/gen-install-sh.mjs for the full rationale.
{
  "$schema": "https://json-schema.org/draft-07/schema",
  "name": "polaris-email-cli-installer",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-15",
  "observability": { "enabled": true },
  "logpush": true,
  // Regenerate src/install.sh.gen.ts from src/install.sh before every
  // bundle, so the served script can never drift from the on-disk source.
  "build": {
    "command": "node scripts/gen-install-sh.mjs",
  },
  // Bind cli.mail.plrs.im as a Workers Custom Domain. Wrangler manages
  // the binding idempotently: the existing CF-side binding (originally
  // created by terraform) is adopted on first deploy.
  "routes": [{ "pattern": "cli.mail.plrs.im", "custom_domain": true }],
  "vars": {
    "ENVIRONMENT": "production",
  },
}
