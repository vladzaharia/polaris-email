{
  "name": "@polaris-mail/panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:server": "tsc -p tsconfig.server.json --noEmit",
    "build:client": "vite build",
    "build": "pnpm run build:client && pnpm run build:server",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "lint": "oxlint .",
    "dev:server": "wrangler dev",
    "dev:client": "vite",
    "deploy": "polaris-mail setup infra deploy service panel"
