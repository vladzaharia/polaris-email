// polaris-email-panel Worker — committed config. Real IDs live in
// wrangler.local.jsonc (gitignored) and are merged in before `wrangler deploy`
// by `polaris-email setup infra deploy`.
//
// The panel binds to the SAME `polaris-email` D1 as services/api (auth tables
// live there alongside the canonical schema), and reaches services/api over a
// one-way service binding (API). Static assets are served from dist/client via
// the Workers Assets binding.
//
// Route / custom domain examples (uncomment in wrangler.local.jsonc):
//   "routes": [{ "pattern": "api.polaris.example.com/panel/*", "zone_name": "polaris.example.com" }]
{
  "$schema": "https://json-schema.org/draft-07/schema",
  "name": "polaris-email-panel",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-04-15",
  "compatibility_flags": ["nodejs_compat_v2"],
  "observability": { "enabled": true },
  "logpush": true,
  "placement": { "mode": "smart" },
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    // SPA fallback: TanStack Router does client-side routing under
    // /panel/*. Without this flag a direct GET to /panel/dashboard
    // (e.g. an operator bookmark or a refresh after navigating) would
    // 404 because dist/client has no matching path. `single-page-application`
    // tells Workers Static Assets to serve index.html for any 404, and
    // the client router takes it from there.
    "not_found_handling": "single-page-application",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "polaris-email",
      "database_id": "REPLACE_WITH_LOCAL",
      "migrations_dir": "migrations",
    },
  ],
  "services": [{ "binding": "API", "service": "polaris-email-api" }],
  // Tail consumer: forwards error/warn logs to services/tail.
  "tail_consumers": [{ "service": "polaris-email-tail" }],
  "vars": {
    "OIDC_ADMIN_GROUP": "polaris-admins",
    // Cookie scope. Default assumes panel runs at api.polaris.example.com/panel
    // (same host as the API), so Path=/panel + no Domain. For subdomain mode
    // (panel.polaris.example.com + api.polaris.example.com), override locally:
    //   COOKIE_DOMAIN=".polaris.example.com"
    "COOKIE_PATH": "/panel",
    // Phase 3e.3 — DEV_MODE / ENVIRONMENT contract:
    //   * `DEV_MODE=1` enables the /api/dev/login backdoor in
    //     routes/session.ts. MUST never be set in production.
    //   * `ENVIRONMENT=production` together with DEV_MODE=1 trips the
    //     runtime refusal in src/server/index.ts (returns 500 on every
    //     request and logs FATAL). The check runs on every fetch entry
    //     so it survives env-var drift after deploy.
    //   * Production deployments should set ENVIRONMENT="production"
    //     here (uncomment) so the assertion fires if DEV_MODE is ever
    //     accidentally set via `wrangler secret put` later.
    // "ENVIRONMENT": "production",
  },
}
