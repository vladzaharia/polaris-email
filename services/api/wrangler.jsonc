// polaris-email-api Worker — committed config. Real IDs live in wrangler.local.jsonc (gitignored)
// and are merged by bin/deploy.sh before `wrangler deploy`.
//
// This Worker fronts three Cloudflare runtimes since phase B1 (worker
// consolidation): HTTP (`fetch`), cron triggers (`scheduled`), and the
// FANOUT_QUEUE consumer (`queue`).
{
  "$schema": "https://json-schema.org/draft-07/schema",
  "name": "polaris-email-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "logpush": true,
  "placement": { "mode": "smart" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "polaris-email",
      "database_id": "REPLACE_WITH_LOCAL",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    { "binding": "R2", "bucket_name": "polaris-email", "jurisdiction": "default" },
    // Audit anchors no longer live in R2 — Phase O1 moved them to an
    // external Object-Lock target (Backblaze B2 by default) written via
    // `packages/object-lock` from `src/scheduled/anchor.ts`. The endpoint /
    // bucket / region land in `vars` below; the access key + secret go
    // through `wrangler secret put ANCHOR_S3_ACCESS_KEY_ID` and
    // `... ANCHOR_S3_SECRET_ACCESS_KEY`.
  ],
  "kv_namespaces": [
    { "binding": "KV_NONCE", "id": "REPLACE_WITH_LOCAL" },
    { "binding": "KV_IDEMPOTENCY", "id": "REPLACE_WITH_LOCAL" },
    { "binding": "KV_RATE_LIMIT", "id": "REPLACE_WITH_LOCAL" },
    { "binding": "KV_KEY_CACHE", "id": "REPLACE_WITH_LOCAL" },
    { "binding": "KV_REVOCATIONS", "id": "REPLACE_WITH_LOCAL" },
  ],
  // Cron triggers absorbed from services/cron in phase B1. Schedules:
  //   `0 * * * *`  hourly  → anchor (audit anchor)
  //   `0 9 * * 1`  weekly  → staleness (control-plane secret freshness)
  //   `* * * * *`  minutely → synthetic (/healthz probe)
  //   `0 3 * * *`  nightly → janitor (retention sweep)
  "triggers": {
    "crons": ["0 * * * *", "0 9 * * 1", "* * * * *", "0 3 * * *"],
  },
  // FANOUT_QUEUE consumer absorbed from services/fanout in phase B1.
  // max_concurrency: 4 keeps webhook latency from contending with the HTTP
  // request path at <10k msg/day; max_batch_size: 10 + max_batch_timeout: 5s
  // gives a small batch window without holding events on the queue.
  "queues": {
    "producers": [{ "binding": "OUTBOUND_QUEUE", "queue": "polaris-email-outbound" }],
    "consumers": [
      {
        "queue": "polaris-email-fanout",
        "max_concurrency": 4,
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 6,
        "dead_letter_queue": "polaris-email-fanout-dlq",
      },
    ],
  },
  "vars": {
    "API_BASE_URL": "https://polaris-email-api.workers.dev",
    // Public R2 custom domain for message bodies + attachments (B5). Keys
    // are content-addressed (SHA-256) so URLs are unguessable; no signing.
    "R2_PUBLIC_HOST": "r2.mail.plrs.im",
    // Scheduled-handler config — absorbed from services/cron.
    "ANCHOR_R2_PREFIX": "anchors/",
    // External Object-Lock target for audit anchors (Phase O1). These three
    // are non-secret config; the access-key id + secret are pushed via
    // `wrangler secret put ANCHOR_S3_ACCESS_KEY_ID` and
    // `wrangler secret put ANCHOR_S3_SECRET_ACCESS_KEY`. See
    // `packages/object-lock` and `infra/terraform/README.md`.
    "ANCHOR_S3_ENDPOINT": "https://s3.us-west-005.backblazeb2.com",
    "ANCHOR_S3_BUCKET": "polaris-anchors",
    "ANCHOR_S3_REGION": "us-west-005",
    "ALERT_WEBHOOK": "https://alerts.example.com/polaris-email",
    "MAX_LATENCY_MS": "300000",
    // Phase C — default TLS-RPT aggregation address. Single mailbox we own;
    // per-domain overrides are stored in mail_domains.tlsrpt_rua.
    "TLSRPT_DEFAULT_RUA": "mailto:tlsrpt@plrs.im",
  },
}
