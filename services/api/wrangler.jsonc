// polaris-email-api Worker — committed config. Real IDs live in wrangler.local.jsonc (gitignored)
// and are merged by bin/deploy.sh before `wrangler deploy`.
//
// This Worker fronts three Cloudflare runtimes since (worker
// consolidation): HTTP (`fetch`), cron triggers (`scheduled`), and the
// FANOUT_QUEUE consumer (`queue`).
{
  "$schema": "https://json-schema.org/draft-07/schema",
  "name": "polaris-email-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-15",
  "compatibility_flags": ["nodejs_compat_v2"],
  "observability": { "enabled": true },
  "logpush": true,
  "placement": { "mode": "smart" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "polaris-email",
      "database_id": "REPLACE_WITH_LOCAL",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "R2", "bucket_name": "polaris-email", "jurisdiction": "default" }],
  "kv_namespaces": [
    { "binding": "KV_NONCE", "id": "REPLACE_WITH_LOCAL" },
    { "binding": "KV_IDEMPOTENCY", "id": "REPLACE_WITH_LOCAL" },
    { "binding": "KV_RATE_LIMIT", "id": "REPLACE_WITH_LOCAL" },
    { "binding": "KV_KEY_CACHE", "id": "REPLACE_WITH_LOCAL" },
    { "binding": "KV_REVOCATIONS", "id": "REPLACE_WITH_LOCAL" },
  ],
  // Cron triggers absorbed from services/cron. The hourly anchor + daily
  // anchor-backfill jobs were removed when off-platform audit anchoring
  // was dropped; audit_log keeps its in-row chained hash invariant and
  // `audit-verify` walks the chain end-to-end nightly.
  //   `*/5 * * * *`  every 5 min  → synthetic (/healthz probe)
  //   `0 9 * * 1`    weekly       → staleness (control-plane secret freshness)
  //   `0 3 * * *`    nightly      → janitor (retention sweep)
  //   `*/15 * * * *` qtr-hourly   → sender-abuse-threshold
  //   `0 4 * * *`    daily 04:00  → dmarc-promote
  //   `0 */6 * * *`  6-hourly     → mta-sts-continuity
  //   `30 */6 * * *` 6-hourly+30  → dkim-self-verify
  //   `0 5 * * *`    daily 05:00  → feedback-window-refresh
  //   `20 5 * * *`   daily 05:20  → audit-verify
  //   `50 5 * * *`   daily 05:50  → policy-backfill
  //   `0 6 * * 0`    weekly Sun   → d1-backup
  "triggers": {
    "crons": [
      "*/5 * * * *",
      "0 9 * * 1",
      "0 3 * * *",
      "*/15 * * * *",
      "0 4 * * *",
      "0 */6 * * *",
      "30 */6 * * *",
      "0 5 * * *",
      "20 5 * * *",
      "50 5 * * *",
      "0 6 * * 0",
    ],
  },
  // FANOUT_QUEUE is bound both as a consumer (webhook fan-out worker) and a
  // producer (so DLQ replay can re-enqueue a fresh FanoutEvent without
  // round-tripping through services/in or services/out). max_concurrency: 4
  // keeps webhook latency from contending with the HTTP request path at
  // <10k msg/day; max_batch_size: 10 + max_batch_timeout: 5s gives a small
  // batch window without holding events on the queue.
  "queues": {
    "producers": [
      { "binding": "OUTBOUND_QUEUE", "queue": "polaris-email-outbound" },
      { "binding": "FANOUT_QUEUE", "queue": "polaris-email-fanout" },
    ],
    "consumers": [
      {
        "queue": "polaris-email-fanout",
        "max_concurrency": 4,
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 6,
        "dead_letter_queue": "polaris-email-fanout-dlq",
      },
    ],
  },
  // Tail consumer: forwards error/warn logs to services/tail, which POSTs
  // them to ALERT_WEBHOOK. Configured here for symmetry with services/in,
  // services/out, apps/panel; the same Tail Worker handles all four.
  "tail_consumers": [{ "service": "polaris-email-tail" }],
  // Analytics Engine: per-domain inbound rate, send_email outcomes, webhook
  // delivery latency. Queried via the CF SQL API in /v1/admin/metrics/*.
  "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "polaris_metrics" }],
  "vars": {
    "API_BASE_URL": "https://polaris-email-api.workers.dev",
    // Public R2 custom domain for message bodies + attachments. Keys
    // are content-addressed (SHA-256) so URLs are unguessable; no signing.
    "R2_PUBLIC_HOST": "r2.mail.plrs.im",
    "ALERT_WEBHOOK": "https://alerts.example.com/polaris-email",
    "MAX_LATENCY_MS": "300000",
    // default TLS-RPT aggregation address. Single mailbox we own;
    // per-domain overrides are stored in mail_domains.tlsrpt_rua.
    "TLSRPT_DEFAULT_RUA": "mailto:tlsrpt@plrs.im",
  },
}
