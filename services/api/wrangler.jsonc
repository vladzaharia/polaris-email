// polaris-email-api Worker — committed config. Real IDs live in wrangler.local.jsonc (gitignored)
// and are merged by bin/deploy.sh before `wrangler deploy`.
{
  "$schema": "https://json-schema.org/draft-07/schema",
  "name": "polaris-email-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "logpush": true,
  "placement": { "mode": "smart" },
  "d1_databases": [
    { "binding": "DB", "database_name": "polaris-email", "database_id": "REPLACE_WITH_LOCAL" }
  ],
  "r2_buckets": [
    { "binding": "R2", "bucket_name": "polaris-email", "jurisdiction": "default" }
  ],
  "kv_namespaces": [
    { "binding": "KV_NONCE", "id": "REPLACE_WITH_LOCAL" },
    { "binding": "KV_IDEMPOTENCY", "id": "REPLACE_WITH_LOCAL" },
    { "binding": "KV_RATE_LIMIT", "id": "REPLACE_WITH_LOCAL" },
    { "binding": "KV_KEY_CACHE", "id": "REPLACE_WITH_LOCAL" }
  ],
  "queues": {
    "producers": [
      { "binding": "OUTBOUND_QUEUE", "queue": "polaris-email-outbound" },
      { "binding": "INBOUND_QUEUE", "queue": "polaris-email-inbound" }
    ]
  },
  "services": [
    { "binding": "FORENSIC", "service": "polaris-email-forensic" }
  ],
  "vars": {
    "VERIFY_ALGORITHMS": "v1",
    "API_BASE_URL": "https://polaris-email-api.workers.dev",
    "BRIDGE_TAILNET_HOST": "polaris-email.example.ts.net",
    "FANOUT_TAG": "tag:polaris-workers"
  }
}
