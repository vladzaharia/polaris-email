// polaris-email-api Worker — committed config. Real IDs live in wrangler.local.jsonc (gitignored)
// and are merged by bin/deploy.sh before `wrangler deploy`.
//
// This Worker fronts three Cloudflare runtimes since phase B1 (worker
// consolidation): HTTP (`fetch`), cron triggers (`scheduled`), and the
// FANOUT_QUEUE consumer (`queue`).
{
  "$schema": "https://json-schema.org/draft-07/schema",
  "name": "polaris-email-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "logpush": true,
  "placement": { "mode": "smart" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "polaris-email",
      "database_id": "REPLACE_WITH_LOCAL",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "R2", "bucket_name": "polaris-email", "jurisdiction": "default" }],
  "kv_namespaces": [
    { "binding": "KV_NONCE", "id": "REPLACE_WITH_LOCAL" },
    { "binding": "KV_IDEMPOTENCY", "id": "REPLACE_WITH_LOCAL" },
    { "binding": "KV_RATE_LIMIT", "id": "REPLACE_WITH_LOCAL" },
    { "binding": "KV_KEY_CACHE", "id": "REPLACE_WITH_LOCAL" },
    { "binding": "KV_REVOCATIONS", "id": "REPLACE_WITH_LOCAL" },
  ],
  // Cron triggers absorbed from services/cron in phase B1. Schedules:
  //   `0 * * * *`  hourly  → anchor (audit anchor)
  //   `0 9 * * 1`  weekly  → staleness (control-plane secret freshness)
  //   `* * * * *`  minutely → synthetic (/healthz probe)
  //   `0 3 * * *`  nightly → janitor (retention sweep)
  "triggers": {
    "crons": ["0 * * * *", "0 9 * * 1", "* * * * *", "0 3 * * *"],
  },
  // FANOUT_QUEUE consumer absorbed from services/fanout in phase B1.
  // max_concurrency: 4 keeps webhook latency from contending with the HTTP
  // request path at <10k msg/day; max_batch_size: 10 + max_batch_timeout: 5s
  // gives a small batch window without holding events on the queue.
  "queues": {
    "producers": [{ "binding": "OUTBOUND_QUEUE", "queue": "polaris-email-outbound" }],
    "consumers": [
      {
        "queue": "polaris-email-fanout",
        "max_concurrency": 4,
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 6,
        "dead_letter_queue": "polaris-email-fanout-dlq",
      },
    ],
  },
  "vars": {
    "API_BASE_URL": "https://polaris-email-api.workers.dev",
    // Scheduled-handler config — absorbed from services/cron.
    "ANCHOR_R2_PREFIX": "anchors/",
    "ALERT_WEBHOOK": "https://alerts.example.com/polaris-email",
    "MAX_LATENCY_MS": "300000",
  },
}
