// Template merged on top of wrangler.jsonc by `polaris-email setup infra
// deploy` (and, during the parity period, bin/deploy.sh). Placeholders use
// Go text/template syntax and are substituted by the Go renderer in
// apps/polaris-cli/internal/setup/wranglercfg from .deploy-state.json +
// .env.deploy. Do NOT hand-edit the materialized wrangler.local.jsonc —
// re-run `polaris-email setup infra render` (or `make configure`) instead.
{
  "account_id": "{{ .Account.ID }}",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "polaris-email",
      "database_id": "{{ .D1.PolarisEmail.ID }}",
    },
  ],
  "r2_buckets": [
    { "binding": "R2", "bucket_name": "polaris-email", "jurisdiction": "eu" },
    // Audit anchors moved off-CF in Phase O1 (see services/api/wrangler.jsonc).
    // Provision the Backblaze B2 bucket + Application Key out-of-band per
    // infra/terraform/README.md, then `wrangler secret put ANCHOR_S3_*`.
  ],
  "kv_namespaces": [
    { "binding": "KV_NONCE", "id": "{{ .KV.Nonce.ID }}" },
    { "binding": "KV_IDEMPOTENCY", "id": "{{ .KV.Idempotency.ID }}" },
    { "binding": "KV_RATE_LIMIT", "id": "{{ .KV.RateLimit.ID }}" },
    { "binding": "KV_KEY_CACHE", "id": "{{ .KV.KeyCache.ID }}" },
    { "binding": "KV_REVOCATIONS", "id": "{{ .KV.Revocations.ID }}" },
  ],
  "vars": {
    "API_BASE_URL": "https://{{ .Hostnames.PolarisAPI }}",
    // R2 public custom domain. The R2 bucket `polaris-email` is fronted
    // by this hostname; both inbound and outbound message bodies/attachments
    // are served from it. See infra/terraform for the DNS + bucket config.
    "R2_PUBLIC_HOST": "{{ .Hostnames.R2Public }}",
    // External anchor target. Non-secret config only; the
    // access-key id + secret are pushed via `wrangler secret put`.
    "ANCHOR_S3_ENDPOINT": "{{ .Anchor.S3Endpoint }}",
    "ANCHOR_S3_BUCKET": "{{ .Anchor.S3Bucket }}",
    "ANCHOR_S3_REGION": "{{ .Anchor.S3Region }}",
    "ALERT_WEBHOOK": "{{ .AlertWebhook }}",
  },
{{- if .SecretsStore.StoreID }}
  "secrets_store_secrets": [
    { "binding": "POLARIS_SECRET_A", "store_id": "{{ .SecretsStore.StoreID }}", "secret_name": "POLARIS_SECRET_A" },
  ],
{{- end }}
}
