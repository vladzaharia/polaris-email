// Template merged on top of wrangler.jsonc by bin/deploy.sh.
// Placeholders are substituted by bin/render-wrangler-local.sh from .deploy-state.json + .env.deploy.
// Do NOT hand-edit the materialized wrangler.local.jsonc — re-run `make configure` instead.
{
  "account_id": "${CF_ACCOUNT_ID}",
  "d1_databases": [
    { "binding": "DB", "database_name": "polaris-email", "database_id": "${D1_ID}" },
  ],
  "r2_buckets": [{ "binding": "R2", "bucket_name": "polaris-email", "jurisdiction": "eu" }],
  "kv_namespaces": [
    { "binding": "KV_NONCE", "id": "${KV_NONCE_ID}" },
    { "binding": "KV_IDEMPOTENCY", "id": "${KV_IDEMPOTENCY_ID}" },
    { "binding": "KV_RATE_LIMIT", "id": "${KV_RATE_LIMIT_ID}" },
    { "binding": "KV_KEY_CACHE", "id": "${KV_KEY_CACHE_ID}" },
    { "binding": "KV_REVOCATIONS", "id": "${KV_REVOCATIONS_ID}" },
  ],
  "vars": {
    "API_BASE_URL": "https://${POLARIS_API_HOSTNAME}",
    // R2 public custom domain (B5). The R2 bucket `polaris-email` is fronted
    // by this hostname; both inbound and outbound message bodies/attachments
    // are served from it. See infra/terraform for the DNS + bucket config.
    "R2_PUBLIC_HOST": "${R2_PUBLIC_HOST}",
    "ALERT_WEBHOOK": "${ALERT_WEBHOOK}",
  },
}
