// Template merged on top of wrangler.jsonc by `polaris-mail setup infra
// deploy`. Placeholders use Go text/template syntax and are substituted
// by the Go renderer in apps/polaris-cli/internal/setup/wranglercfg from
// .deploy-state.json + .env.deploy. Do NOT hand-edit the materialized
// wrangler.local.jsonc — re-run `polaris-mail setup infra render` instead.
{
  "account_id": "{{ .Account.ID }}",
  // Workers Custom Domain binding. wrangler manages the binding
  // idempotently: provisioned on first deploy, retained on subsequent
  // deploys, cleaned up on Worker delete. The hostname comes from
  // POLARIS_API_HOSTNAME in .env.deploy.
  "routes": [
    { "pattern": "{{ .Hostnames.PolarisAPI }}", "custom_domain": true },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "polaris-mail",
      "database_id": "{{ .D1.PolarisMail.ID }}",
    },
  ],
  "r2_buckets": [{ "binding": "R2", "bucket_name": "polaris-mail", "jurisdiction": "eu" }],
  "kv_namespaces": [
    { "binding": "KV_NONCE", "id": "{{ .KV.Nonce.ID }}" },
    { "binding": "KV_IDEMPOTENCY", "id": "{{ .KV.Idempotency.ID }}" },
    { "binding": "KV_RATE_LIMIT", "id": "{{ .KV.RateLimit.ID }}" },
    { "binding": "KV_KEY_CACHE", "id": "{{ .KV.KeyCache.ID }}" },
    { "binding": "KV_REVOCATIONS", "id": "{{ .KV.Revocations.ID }}" },
  ],
  "vars": {
    "API_BASE_URL": "https://{{ .Hostnames.PolarisAPI }}",
    // R2 public custom domain. The R2 bucket `polaris-mail` is fronted
    // by this hostname; both inbound and outbound message bodies/attachments
    // are served from it. The binding is provisioned during
    // `polaris-mail setup infra apply` from R2_PUBLIC_HOST in .env.deploy.
    "R2_PUBLIC_HOST": "{{ .Hostnames.R2Public }}",
    "ALERT_WEBHOOK": "{{ .AlertWebhook }}",
  },
{{- if .SecretsStore.StoreID }}
  "secrets_store_secrets": [
    { "binding": "POLARIS_SECRET_A", "store_id": "{{ .SecretsStore.StoreID }}", "secret_name": "POLARIS_SECRET_A" },
  ],
{{- end }}
}
