// polaris-mail-in: Email Routing handler.
{
  "$schema": "https://json-schema.org/draft-07/schema",
  "name": "polaris-mail-in",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-15",
  "compatibility_flags": ["nodejs_compat_v2"],
  "observability": { "enabled": true },
  "logpush": true,
  "placement": { "mode": "smart" },
  "d1_databases": [
    { "binding": "DB", "database_name": "polaris-mail", "database_id": "REPLACE_WITH_LOCAL" },
  ],
  "r2_buckets": [{ "binding": "R2", "bucket_name": "polaris-mail" }],
  "kv_namespaces": [
    { "binding": "KV_RATE_LIMIT", "id": "REPLACE_WITH_LOCAL" },
    // W2b — daily Workers AI budget counter for the triage handler.
    { "binding": "KV_IDEMPOTENCY", "id": "REPLACE_WITH_LOCAL" },
  ],
  "queues": {
    "producers": [{ "binding": "FANOUT_QUEUE", "queue": "polaris-mail-fanout" }],
  },
  // W2b — Workers AI binding so services/in/triage.ts can invoke a JSON-mode
  // Llama for unstructured complaint classification. The binding is named
  // `AI` per the @cloudflare/ai convention.
  "ai": { "binding": "AI" },
  // Tail consumer: forwards error/warn logs to services/tail.
  "tail_consumers": [{ "service": "polaris-mail-tail" }],
  // Analytics Engine: per-domain inbound rate. Shared dataset with api + out.
  "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "polaris_metrics" }],
}
