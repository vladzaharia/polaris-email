{
  "$schema": "https://json-schema.org/draft-07/schema",
  "name": "polaris-email-cron",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "observability": { "enabled": true },
  "triggers": {
    "crons": [
      "0 * * * *",
      "0 9 * * 1",
      "* * * * *",
      "0 3 * * *"
    ]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "polaris-email", "database_id": "REPLACE_WITH_LOCAL" }
  ],
  "r2_buckets": [
    { "binding": "R2", "bucket_name": "polaris-email" }
  ],
  "vars": {
    "ANCHOR_R2_PREFIX": "anchors/",
    "ALERT_WEBHOOK": "https://alerts.example.com/polaris-email",
    "API_BASE_URL": "https://polaris-email-api.workers.dev",
    "MAX_LATENCY_MS": "300000"
  }
}
