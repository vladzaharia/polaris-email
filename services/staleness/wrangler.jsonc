{
  "$schema": "https://json-schema.org/draft-07/schema",
  "name": "polaris-email-staleness",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "observability": { "enabled": true },
  "triggers": { "crons": ["0 9 * * 1"] },
  "d1_databases": [{ "binding": "DB", "database_name": "polaris-email", "database_id": "REPLACE_WITH_LOCAL" }],
  "vars": { "ALERT_WEBHOOK": "https://alerts.example.com/polaris-email-staleness" }
}
