{
  "$schema": "https://json-schema.org/draft-07/schema",
  "name": "polaris-email-synthetic",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "observability": { "enabled": true },
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "API_BASE_URL": "https://polaris-email-api.workers.dev",
    "ALERT_WEBHOOK": "https://alerts.example.com/polaris-email",
    "SYNTHETIC_FROM": "synthetic@example.com",
    "SYNTHETIC_TO": "synthetic@in.example.com",
    "MAX_LATENCY_MS": "300000"
  }
}
