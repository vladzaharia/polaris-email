{
  "name": "@polaris/sdk",
  "version": "0.1.0",
  "//private": "Internal-only within the polaris-* service family (see LICENSE). Not published to npm; consumed via pnpm workspace by apps/panel and services/*. Removing `private` requires a LICENSE change and a publish workflow (publishConfig, repository, npm credentials).",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./webhook": {
      "import": "./dist/webhook.js",
      "types": "./dist/webhook.d.ts"
    },
    "./node": {
      "import": "./dist/node.js",
      "types": "./dist/node.d.ts"
    },
    "./react": {
      "import": "./dist/react.js",
      "types": "./dist/react.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "oxlint ."
  },
  "dependencies": {
    "@polaris-email/hmac": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
