node_modules/
dist/
# Override any global gitignore that swallows services/out (common: `out/` in user gitignore).
# Negate the directory itself so git descends; sub-rules (node_modules/, dist/, etc.) still apply.
!services/out/
.wrangler/
.dev.vars
.dev.vars.*
wrangler.local.jsonc
wrangler.local.toml
*.log
.DS_Store
coverage/
.vitest/
.turbo/
.cache/
*.tsbuildinfo
mox-data/
mox-config/certs/
ts-state/
.env
.env.*
!.env.example
# Exception: golden-file fixtures under testdata/ — these are deterministic
# sample renderings (no real secrets) and must be tracked so tests reproduce.
!**/testdata/**/.env
!**/testdata/**/.env.*
__pycache__/
*.pyc
.pytest_cache/
go.sum.local
.env.deploy
.deploy-state.json
.deploy-state.last-sha
.bootstrap-output.json
.ssh-bootstrap-output.json
secrets.created.json
.wrangler.merged.json
# Claude Code per-project state (settings, worktrees, plans).
.claude/
.worktrees/

# Terraform
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
.terraform.lock.hcl
*.tfplan
*.tfvars
!*.tfvars.example
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
